# Copy this file to ".env" and fill in your two Supabase values.
# Find them in Supabase: Project Settings -> API.
# These are safe to expose in a frontend (the anon key is public by design,
# protected by Row Level Security in the database).

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public domain, used so a flyer rendered for print or email carries the
# real address instead of whatever host it was built on.
VITE_SITE_URL=kp-fung-saffreon.vercel.app
